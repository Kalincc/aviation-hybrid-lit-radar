# ===== Aviation Hybrid Lit Radar 环境变量 =====
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，请勿提交真实 Key。

# DeepSeek（配置后启用 LLM 结构化提取；留空则自动降级为启发式提取）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Semantic Scholar Graph API（可选；无 Key 时容易 429，默认跳过该源）
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex polite pool 联系方式（可选，建议填邮箱）
OPENALEX_MAILTO=

# 服务与默认抓取参数
PORT=8000
DEFAULT_DAYS=90
